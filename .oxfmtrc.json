{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": false,
  "singleQuote": true,
  "trailingComma": "all",
  "endOfLine": "lf",
  "proseWrap": "preserve",
  "sortPackageJson": true,
  "ignorePatterns": ["apps/benchmarks/RESULTS.md", ".changeset/*.md"]
}
