{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreDependencies": ["@webgpu/types"],
  "include": [
    "files",
    "dependencies",
    "devDependencies",
    "optionalPeerDependencies",
    "unlisted",
    "unresolved",
    "binaries",
    "catalog"
  ],
  "workspaces": {
    ".": {
      "entry": [],
      "project": []
    },
    "packages/*": {
      "project": "src/**/*.{ts,tsx}"
    },
    "apps/benchmarks": {
      "project": "*.mjs",
      "ignoreDependencies": ["three", "aalib.js", "textmode.js", "chafa-wasm"]
    },
    "apps/docs": {
      "entry": ["src/pages/**/*.astro", "src/playground/main.ts", "ascii-fx.config.ts"],
      "project": "src/**/*.{ts,astro}"
    }
  },
  "ignoreBinaries": ["ffmpeg", "img2webp"]
}
