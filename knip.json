{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreDependencies": ["@webgpu/types"],
  "workspaces": {
    ".": {
      "entry": [],
      "project": []
    },
    "packages/*": {
      "project": "src/**/*.{ts,tsx}"
    },
    "apps/playground": {
      "project": "src/**/*.ts"
    },
    "apps/benchmarks": {
      "project": "*.mjs",
      "ignoreDependencies": ["three", "aalib.js", "p5", "p5.asciify", "chafa-wasm"]
    },
    "apps/docs": {
      "entry": ["src/pages/**/*.astro", "src/scripts/*.ts", "ascii-fx.config.ts"],
      "project": "src/**/*.{ts,astro}"
    }
  }
}
