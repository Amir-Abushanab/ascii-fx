{
  "name": "@ascii-fx/gpu",
  "version": "0.6.0",
  "description": "WebGPU renderer for ASCII FX: exact structural-v1 compute matching and one-draw atlas compositing, with a CPU fallback.",
  "keywords": [
    "ascii",
    "ascii-art",
    "ascii-fx",
    "canvas",
    "compute-shader",
    "gpgpu",
    "renderer",
    "webgpu"
  ],
  "homepage": "https://github.com/Amir-Abushanab/ascii-fx#readme",
  "bugs": {
    "url": "https://github.com/Amir-Abushanab/ascii-fx/issues"
  },
  "license": "MIT",
  "author": "Amir Abushanab (https://github.com/Amir-Abushanab)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Amir-Abushanab/ascii-fx.git",
    "directory": "packages/gpu"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tilt": {
      "types": "./dist/tilt.d.ts",
      "default": "./dist/tilt.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ascii-fx/core": "workspace:*"
  },
  "devDependencies": {
    "@webgpu/types": "^0.1.72",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22"
  }
}
