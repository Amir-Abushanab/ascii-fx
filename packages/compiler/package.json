{
  "name": "@ascii-fx/compiler",
  "version": "0.1.0",
  "description": "Build-time compiler for ASCII FX: deterministic font rasterization, glyph atlases, .asciip/.asciif generation.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "bin": {
    "ascii-fx": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ascii-fx/core": "workspace:*",
    "fontkit": "^2.0.4",
    "pngjs": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/pngjs": "^6.0.5",
    "tsup": "^8.5.1",
    "typescript": "^6.0.0"
  }
}
