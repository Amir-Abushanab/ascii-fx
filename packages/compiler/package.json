{
  "name": "@ascii-fx/compiler",
  "version": "0.5.0",
  "description": "Build-time compiler for ASCII FX: deterministic font rasterization, glyph atlases, .asciip/.asciif generation.",
  "keywords": [
    "ascii",
    "ascii-art",
    "ascii-fx",
    "build-tool",
    "cli",
    "font",
    "glyph-atlas",
    "rasterizer"
  ],
  "homepage": "https://github.com/Amir-Abushanab/ascii-fx#readme",
  "bugs": {
    "url": "https://github.com/Amir-Abushanab/ascii-fx/issues"
  },
  "license": "MIT",
  "author": "Amir Abushanab (https://github.com/Amir-Abushanab)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Amir-Abushanab/ascii-fx.git",
    "directory": "packages/compiler"
  },
  "bin": {
    "ascii-fx": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json && node scripts/postbuild.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ascii-fx/core": "workspace:*",
    "fontkit": "^2.0.4",
    "pngjs": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/pngjs": "^6.0.5",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22"
  }
}
