{
  "name": "@ascii-fx/three",
  "version": "0.3.1",
  "description": "Three.js adapter for ASCII FX: AsciiPass postprocessing for WebGPURenderer and an instanced AsciiGlyphs renderer.",
  "keywords": [
    "ascii",
    "ascii-art",
    "ascii-fx",
    "postprocessing",
    "three",
    "threejs",
    "webgpu"
  ],
  "homepage": "https://github.com/Amir-Abushanab/ascii-fx#readme",
  "bugs": {
    "url": "https://github.com/Amir-Abushanab/ascii-fx/issues"
  },
  "license": "MIT",
  "author": "Amir Abushanab (https://github.com/Amir-Abushanab)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Amir-Abushanab/ascii-fx.git",
    "directory": "packages/three"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ascii-fx/core": "workspace:*",
    "@ascii-fx/gpu": "workspace:*"
  },
  "devDependencies": {
    "@types/three": "0.185.4",
    "@webgpu/types": "^0.1.72",
    "three": "0.185.1",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "three": ">=0.170.0"
  },
  "engines": {
    "node": ">=22"
  }
}
