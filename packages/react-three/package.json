{
  "name": "@ascii-fx/react-three",
  "version": "0.3.1",
  "description": "React Three Fiber bindings for ASCII FX: <AsciiEffect>, <AsciiGlyphs>, useAsciiEffect (WebGPURenderer only).",
  "keywords": [
    "ascii",
    "ascii-art",
    "ascii-fx",
    "postprocessing",
    "react",
    "react-three-fiber",
    "three",
    "threejs",
    "webgpu"
  ],
  "homepage": "https://github.com/Amir-Abushanab/ascii-fx#readme",
  "bugs": {
    "url": "https://github.com/Amir-Abushanab/ascii-fx/issues"
  },
  "license": "MIT",
  "author": "Amir Abushanab (https://github.com/Amir-Abushanab)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Amir-Abushanab/ascii-fx.git",
    "directory": "packages/react-three"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ascii-fx/core": "workspace:*",
    "@ascii-fx/gpu": "workspace:*",
    "@ascii-fx/three": "workspace:*"
  },
  "devDependencies": {
    "@react-three/fiber": "^9.7.0",
    "@types/react": "^19.2.18",
    "@types/three": "0.185.4",
    "@webgpu/types": "^0.1.71",
    "react": "^19.2.8",
    "three": "0.185.1",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@react-three/fiber": "^9.0.0",
    "react": "^19.0.0",
    "three": ">=0.170.0"
  },
  "engines": {
    "node": ">=22"
  }
}
