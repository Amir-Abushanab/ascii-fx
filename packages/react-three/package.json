{
  "name": "@ascii-fx/react-three",
  "version": "0.1.0",
  "description": "React Three Fiber bindings for ASCII FX: <AsciiEffect>, <AsciiGlyphs>, useAsciiEffect (WebGPURenderer only).",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@react-three/fiber": "^9.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "three": ">=0.170.0"
  },
  "dependencies": {
    "@ascii-fx/core": "workspace:*",
    "@ascii-fx/gpu": "workspace:*",
    "@ascii-fx/three": "workspace:*"
  },
  "devDependencies": {
    "@react-three/fiber": "^9.7.0",
    "@types/react": "^19.2.18",
    "@types/three": "0.185.4",
    "@webgpu/types": "^0.1.71",
    "react": "^19.2.8",
    "three": "0.185.1",
    "tsup": "^8.5.1",
    "typescript": "^6.0.0"
  }
}
