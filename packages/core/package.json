{
  "name": "@ascii-fx/core",
  "version": "0.1.0",
  "description": "High-fidelity structural ASCII rendering — core types, exact CPU matcher, profile/frame codecs.",
  "keywords": [
    "ascii",
    "ascii-art",
    "ascii-fx",
    "glyph-atlas",
    "image-to-ascii",
    "renderer",
    "structural-matching",
    "tanstack-intent"
  ],
  "homepage": "https://github.com/Amir-Abushanab/ascii-fx#readme",
  "bugs": {
    "url": "https://github.com/Amir-Abushanab/ascii-fx/issues"
  },
  "license": "MIT",
  "author": "Amir Abushanab (https://github.com/Amir-Abushanab)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Amir-Abushanab/ascii-fx.git",
    "directory": "packages/core"
  },
  "files": [
    "dist",
    "skills"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./canvas2d": {
      "types": "./dist/canvas2d.d.ts",
      "default": "./dist/canvas2d.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "skill:stale": "intent stale skills",
    "skill:validate": "intent validate skills",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@tanstack/intent": "^0.3.6",
    "@webgpu/types": "^0.1.71",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22"
  }
}
