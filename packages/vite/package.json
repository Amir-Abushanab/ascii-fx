{
  "name": "@ascii-fx/vite",
  "version": "0.1.0",
  "description": "Vite integration for ASCII FX: build-time profile compilation and static frame generation as virtual modules.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./client.d.ts"
    }
  },
  "files": [
    "dist",
    "client.d.ts"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "vite": "^5.0.0 || ^6.0.0 || ^7.0.0"
  },
  "dependencies": {
    "@ascii-fx/compiler": "workspace:*",
    "@ascii-fx/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "tsup": "^8.5.1",
    "typescript": "^6.0.0",
    "vite": "^8.2.0",
    "pngjs": "^7.0.0",
    "@types/pngjs": "^6.0.5"
  }
}
