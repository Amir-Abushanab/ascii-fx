---
// Cross-library benchmark, visual form. Only presentation lives here — the
// logo, brand colour and one-line description. Every number is read out of
// apps/benchmarks/RESULTS.md at build time, so regenerating the benchmark is
// the only way these bars move. Bar order follows measured fps, not this list.
import { lib } from '../lib/results'

interface Props {
  compact?: boolean
}
const { compact = false } = Astro.props

interface Entry {
  id: string
  /** Row label in RESULTS.md — the join key for the measured numbers. */
  results: string
  logo: 'fx' | 'p5' | 'three' | 'aa' | 'ch'
  name: string
  detail: string
  shape: boolean
  color: string
  us?: boolean
}

const ENTRIES: Entry[] = [
  { id: 'fx-gpu', results: 'ascii-fx webgpu', logo: 'fx', name: 'ascii-fx · WebGPU', detail: 'exact structural + fitted color', shape: true, color: '#7c9cff', us: true },
  { id: 'p5', results: 'p5.asciify', logo: 'p5', name: 'p5.asciify 0.10', detail: 'brightness + color · WebGL', shape: false, color: '#ed225d' },
  { id: 'three', results: 'three.js AsciiEffect', logo: 'three', name: 'three.js AsciiEffect', detail: 'brightness · DOM', shape: false, color: '#049ef4' },
  { id: 'aa-mono', results: 'aalib.js mono', logo: 'aa', name: 'aalib.js 2.0 · mono', detail: 'brightness · canvas', shape: false, color: '#8a8a99' },
  { id: 'aa-color', results: 'aalib.js colored', logo: 'aa', name: 'aalib.js 2.0 · colored', detail: 'brightness + color · canvas', shape: false, color: '#8a8a99' },
  { id: 'fx-cpu', results: 'ascii-fx cpu', logo: 'fx', name: 'ascii-fx · CPU fallback', detail: 'same exact output, no GPU needed', shape: true, color: '#54608a', us: true },
  { id: 'chafa', results: 'chafa-wasm', logo: 'ch', name: 'chafa-wasm 0.3', detail: 'shape-aware blocks · wasm', shape: true, color: '#654ff0' },
]

const COMPACT_IDS = ['fx-gpu', 'p5', 'three', 'aa-mono', 'chafa']

const rows = ENTRIES.filter((e) => !compact || COMPACT_IDS.includes(e.id))
  .map((e) => ({ ...e, ...lib(e.results) }))
  .sort((a, b) => b.fps - a.fps)
const maxFps = Math.max(...rows.map((r) => r.fps))
---

<div class="bench" role="table" aria-label="Frames per second by library, higher is better">
  {rows.map((r) => (
    <div class="bench-row" data-us={r.us || undefined} role="row">
      <div class="bench-logo" style={`color:${r.color}`} aria-hidden="true">
        {r.logo === 'fx' && <svg viewBox="0 0 20 20"><rect x="1" y="1" width="18" height="18" rx="4" fill="none" stroke="currentColor" stroke-width="1.6" /><text x="10" y="14.2" text-anchor="middle" font-size="9.5" font-weight="700" font-family="Geist Mono, monospace" fill="currentColor">fx</text></svg>}
        {r.logo === 'p5' && <svg viewBox="0 0 20 20"><g stroke="currentColor" stroke-width="3" stroke-linecap="round"><line x1="10" y1="2.5" x2="10" y2="17.5" /><line x1="3.5" y1="6.25" x2="16.5" y2="13.75" /><line x1="3.5" y1="13.75" x2="16.5" y2="6.25" /></g></svg>}
        {r.logo === 'three' && <svg viewBox="0 0 20 20"><g fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"><path d="M2.5 2.5 L17.5 6.8 L6.6 17.5 Z" /><path d="M10 4.65 L12.05 12.15 L4.55 10.0" /></g></svg>}
        {r.logo === 'aa' && <svg viewBox="0 0 20 20"><text x="10" y="14.5" text-anchor="middle" font-size="10" font-weight="700" font-family="Geist Mono, monospace" fill="currentColor">aa</text></svg>}
        {r.logo === 'ch' && <svg viewBox="0 0 20 20"><g fill="currentColor"><rect x="2.4" y="2.4" width="7" height="7" rx="1.2" /><rect x="10.6" y="10.6" width="7" height="7" rx="1.2" /><rect x="10.6" y="2.4" width="7" height="7" rx="1.2" opacity="0.45" /><rect x="2.4" y="10.6" width="7" height="7" rx="1.2" opacity="0.45" /></g></svg>}
      </div>
      <div class="bench-name" role="cell">
        <b>{r.name}{r.shape && <span class="chip">shape-aware</span>}</b>
        <span>{r.detail}</span>
      </div>
      <div class="bench-track" role="cell" aria-hidden="true">
        <div class="bench-bar" style={`width:${((r.fps / maxFps) * 100).toFixed(1)}%; --bar:${r.color}`}></div>
      </div>
      <div class="bench-nums" role="cell">
        <b>{r.fps} fps</b>
        <span>{r.p50.toFixed(1)} ms/frame p50</span>
      </div>
    </div>
  ))}
</div>

<style>
  /* ——— cross-library benchmark visual ——— */
  .bench {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin: 1.6rem 0 2.2rem;
  }
  .bench-row {
    display: grid;
    grid-template-columns: 34px minmax(160px, 220px) 1fr 116px;
    gap: 1.1rem;
    align-items: center;
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 0.85rem 1.05rem;
  }
  .bench-row[data-us] {
    border-color: var(--accent);
    box-shadow: 0 0 0 1px var(--accent) inset;
  }
  .bench-logo {
    width: 30px;
    height: 30px;
    display: grid;
    place-items: center;
    border-radius: 7px;
    border: 1px solid var(--border);
    background: #0d0d14;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0;
  }
  .bench-logo svg {
    width: 20px;
    height: 20px;
    display: block;
  }
  .bench-name {
    min-width: 0;
  }
  .bench-name b {
    display: block;
    font-size: 0.9rem;
    white-space: nowrap;
    margin-bottom: 0.15rem;
  }
  .bench-name span {
    color: var(--muted);
    font-size: 0.74rem;
    white-space: nowrap;
  }
  .bench-name .chip {
    display: inline-block;
    border: 1px solid var(--accent2);
    color: var(--accent2);
    border-radius: 999px;
    padding: 0 0.45em;
    margin-left: 0.4em;
    font-size: 0.68rem;
    vertical-align: 1px;
  }
  .bench-track {
    position: relative;
    height: 18px;
    background: #0d0d14;
    border-radius: 999px;
    overflow: hidden;
    border: 1px solid var(--border);
  }
  .bench-bar {
    position: absolute;
    inset: 0 auto 0 0;
    border-radius: 999px;
    background: linear-gradient(90deg, color-mix(in srgb, var(--bar, var(--accent)) 45%, transparent), var(--bar, var(--accent)));
    min-width: 6px;
  }
  .bench-nums {
    text-align: right;
    font-variant-numeric: tabular-nums;
    font-size: 0.8rem;
    white-space: nowrap;
  }
  .bench-nums b {
    display: block;
    font-size: 0.92rem;
  }
  .bench-nums span {
    color: var(--muted);
    font-size: 0.72rem;
  }
  @media (max-width: 640px) {
    .bench-row {
      grid-template-columns: 34px 1fr auto;
      gap: 0.6rem;
    }
    .bench-track {
      display: none;
    }
    /* Without the bar there is no spare room, so the label wraps instead of
       running underneath the numbers. */
    .bench-name b,
    .bench-name span {
      white-space: normal;
    }
    .bench-name .chip {
      margin-left: 0.35em;
    }
  }
</style>
