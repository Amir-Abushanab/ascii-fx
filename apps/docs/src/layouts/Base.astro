---
import '../styles/global.css'

interface Props {
  title: string
  description?: string
  active: string
}

const { title, description, active } = Astro.props
const base = import.meta.env.BASE_URL
const links = [
  ['', 'demo'],
  ['play/', 'playground'],
  ['guide/', 'guide'],
  ['internals/', 'internals'],
  ['performance/', 'performance'],
]
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description ?? 'High-fidelity structural ASCII rendering for the web.'} />
  </head>
  <body>
    <div class="wrap">
      <nav>
        <a class="brand" href={base}>ASCII FX</a>
        {links.map(([path, label]) => (
          <a href={base + path} aria-current={active === label ? 'page' : undefined}>{label}</a>
        ))}
        <a href="https://github.com/" title="Repository">source</a>
      </nav>
      <slot />
      <footer>
        ASCII FX — shape, not brightness. Exact structural matching on WebGPU with a bit-identical CPU reference.
        Geist Mono under the SIL Open Font License. Structural approach inspired by Ditherlab/chafa; shape-vector
        work inspired by Alex Harri.
      </footer>
    </div>
  </body>
</html>
