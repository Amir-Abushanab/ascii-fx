---
// The playground: the interactive control room plus the pipeline explainer.
// It lives here rather than in its own Vite app so the site is one build and
// one dev server; `import.meta.env.BASE_URL` covers what PG_BASE used to.
import { Code } from 'astro:components'
import BenchChart from '../components/BenchChart.astro'
import BenchRunner from '../components/BenchRunner.astro'
import {
  baseline,
  cpuReference,
  crossLibrary,
  crossLibraryGeneratedAt,
  emojiCrossGeneratedAt,
  emojiCrossLibrary,
  lib,
  matcher,
  worstRecall,
} from '../lib/results'

const base = import.meta.env.BASE_URL

// Where this page actually lives once published. Crawlers resolve nothing relative, so
// the canonical, og:url and og:image below all have to be absolute — and pointing them at
// a dev server's origin would tell an indexer the wrong home. The deploy derives
// DOCS_SITE (Astro.site) from the repository owner so a fork canonicalises to itself; a
// build without it falls back to where this repo's own Pages site is.
const PUBLISHED = 'https://amir-abushanab.github.io/ascii-fx/'
const canonical = Astro.site ? new URL(base, Astro.site).href : PUBLISHED
const ogImage = new URL('og.png', canonical).href
const repository = 'https://github.com/Amir-Abushanab/ascii-fx'

// One sentence, written for a search result and a link preview rather than for the page:
// what it does, then the one thing that makes it different. Reused by every tag below and
// by the structured data, so the three can never disagree.
const TITLE = 'ASCII FX — real-time ASCII rendering for the web'
const DESCRIPTION =
  'Turn images and video into ASCII that actually looks like the picture. Glyphs matched ' +
  'by 8×8 shape, not a brightness ramp — in real time on WebGPU, with an exact CPU fallback.'
const OG_ALT =
  'ASCII FX: a 3D scene of tumbling solids rendered entirely in coloured ASCII characters.'

// schema.org, so a crawler can tell that the playground, the repository and the packages
// are one thing rather than three. No aggregateRating or offers — there are none, and
// inventing them is what gets structured data ignored.
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${canonical}#website`,
      url: canonical,
      name: 'ASCII FX',
      description: DESCRIPTION,
      inLanguage: 'en',
    },
    {
      '@type': 'SoftwareSourceCode',
      '@id': `${canonical}#software`,
      name: 'ASCII FX',
      description: DESCRIPTION,
      url: canonical,
      image: ogImage,
      codeRepository: repository,
      programmingLanguage: ['TypeScript', 'WGSL', 'GLSL'],
      runtimePlatform: 'Web browser',
      license: 'https://spdx.org/licenses/MIT.html',
      author: { '@type': 'Person', name: 'Amir Abushanab', url: 'https://github.com/Amir-Abushanab' },
      keywords: 'ASCII art, ASCII rendering, WebGPU, image to ASCII, video to ASCII, React',
    },
  ],
}

// The page speaks the same font the default profile was compiled from. The URL
// has to carry the site base, so this rule is built here rather than sitting in
// the static stylesheet below.
const fontFace = `@font-face {
  font-family: 'Geist Mono';
  src: url('${base}GeistMono-Regular.ttf') format('truetype');
  font-display: swap;
}`
// Presentation only. Every number below comes from apps/benchmarks/RESULTS.md;
// a contender the harness starts emitting without an entry here fails the build
// rather than silently vanishing from the published table.
interface RowMeta {
  label: string
  picks: string
  /** How the glyph is chosen — drives the tag colour, since that is the axis
      the table exists to compare. */
  kind: 'exact' | 'shape' | 'brightness' | 'none'
  /** Family colour, shared with the chart above so rows read across both. */
  color: string
  /** Ours: tinted so the reader can find us without hunting. */
  us?: boolean
  /** Bold the row: this is us, at the setting we recommend. */
  emphasis?: boolean
  /** Footnote marker explained under the table. */
  marker?: string
}

const TABLE_META: Record<string, RowMeta> = {
  'baseline (no ascii)': { label: 'baseline · scene only, no ascii', picks: '—', kind: 'none', color: '#565668' },
  'ascii-fx webgpu': { label: 'ascii-fx · WebGPU', picks: 'shape, exact', kind: 'exact', color: '#45e845', us: true, emphasis: true },
  'ramp reference mono': { label: 'ramp reference · mono', picks: 'brightness', kind: 'brightness', color: '#565668', marker: '*' },
  'textmode.js': { label: 'textmode.js 0.17 (WebGL)', picks: 'brightness + color', kind: 'brightness', color: '#ed225d' },
  'three.js AsciiEffect': { label: 'three.js AsciiEffect (0.185)', picks: 'brightness', kind: 'brightness', color: '#049ef4' },
  'ramp reference color': { label: 'ramp reference · color', picks: 'brightness + color', kind: 'brightness', color: '#565668', marker: '*' },
  'aalib.js mono': { label: 'aalib.js 2.0 · mono', picks: 'brightness', kind: 'brightness', color: '#8a8a99' },
  'aalib.js colored': { label: 'aalib.js 2.0 · colored', picks: 'brightness + color', kind: 'brightness', color: '#8a8a99' },
  'ascii-fx ramp matcher': { label: 'ascii-fx ramp matcher', picks: 'brightness', kind: 'brightness', color: '#4d7d59', us: true, marker: '†' },
  'ascii-fx shape6-lut': { label: 'ascii-fx shape6-lut (Harri-style)', picks: '6-D shape vector', kind: 'shape', color: '#4d7d59', us: true, marker: '†' },
  'ascii-fx cpu (workers+webgl)': { label: 'ascii-fx · fallback, no GPU', picks: 'shape, exact', kind: 'exact', color: '#4d7d59', us: true, emphasis: true, marker: '‡' },
  'ascii-fx cpu (workers)': { label: 'ascii-fx · fallback, Canvas2D paint', picks: 'shape, exact', kind: 'exact', color: '#4d7d59', us: true, marker: '†' },
  'ascii-fx cpu': { label: 'ascii-fx · fallback, one thread', picks: 'shape, exact', kind: 'exact', color: '#4d7d59', us: true, marker: '†' },
  'chafa-wasm': { label: 'chafa-wasm 0.3', picks: 'shape-aware blocks', kind: 'shape', color: '#654ff0' },
}

interface EmojiRowMeta {
  label: string
  picks: string
  kind: 'exact' | 'brightness'
  us?: boolean
  emphasis?: boolean
}

const EMOJI_TABLE_META: Record<string, EmojiRowMeta> = {
  'ascii-fx emoji webgpu': { label: 'ascii-fx · WebGPU', picks: 'shape + baked colour', kind: 'exact', us: true, emphasis: true },
  'mean-color reference (cube LUT)': { label: 'mean-colour reference · cube LUT', picks: 'mean colour', kind: 'brightness' },
  'mean-color reference (scan)': { label: 'mean-colour reference · linear scan', picks: 'mean colour', kind: 'brightness' },
  'ascii-fx emoji cpu': { label: 'ascii-fx · CPU fallback', picks: 'shape + baked colour', kind: 'exact', us: true },
}

const emojiRows = (emojiCrossLibrary ?? [])
  .map((r) => {
    const meta = EMOJI_TABLE_META[r.name]
    if (!meta) {
      throw new Error(
        `index.astro has no presentation entry for the emoji benchmark row "${r.name}". ` +
          `Add it to EMOJI_TABLE_META (or drop the row from the harness).`,
      )
    }
    return { ...r, ...meta }
  })
  .toSorted((a, b) => a.p50 - b.p50)

const emojiMeasuredOn = emojiCrossGeneratedAt ? new Date(emojiCrossGeneratedAt).toISOString().slice(0, 10) : null

const rows = crossLibrary
  .map((r) => {
    const meta = TABLE_META[r.name]
    if (!meta) {
      throw new Error(
        `index.astro has no presentation entry for the benchmark row "${r.name}". ` +
          `Add it to TABLE_META (or drop the row from the harness).`,
      )
    }
    // The harness appends notes like "160×42 · match 9.9ms"; the table shows the
    // grid, the footnote carries the matcher cost.
    const [grid] = r.grid.split(' · ')
    return { ...r, ...meta, grid, overFloor: r.p50 - baseline.p50 }
  })
  .toSorted((a, b) => a.p50 - b.p50)

// "over floor" is the column that carries the argument, so it gets drawn as a
// bar as well as a number; every bar is scaled against the slowest row.
const worstOverFloor = Math.max(...rows.map((r) => r.overFloor))

/** Matcher-only cost the harness recorded alongside a row's grid, in ms. */
const matchMs = (name: string): string => {
  const note = lib(name).grid.match(/match ([\d.]+)ms/)
  if (!note) throw new Error(`RESULTS.md row "${name}" no longer carries a "match <n>ms" note.`)
  return note[1]
}

const exactMs = matcher('structural (exact)').ms
const cpuFull = cpuReference.filter((r) => r.color === 'full')
const cpu160 = cpuFull.find((r) => r.grid === '160×42')
const webgpu = lib('ascii-fx webgpu')

const APPROX = [
  { results: 'shape6 + LUT', quality: `small error deltas in full color; structural recall collapses on dense texture (worst corpus case ${worstRecall('shape6-lut').recall}%)` },
  { results: 'shape6 brute', quality: 'similar; no 512KiB LUT payload' },
  { results: 'ramp', quality: 'brightness only. An effect, not a fidelity mode' },
].map((a) => ({ ...a, ...matcher(a.results) }))

const measuredOn = new Date(crossLibraryGeneratedAt).toISOString().slice(0, 10)

// Shown on the page, highlighted at build time by Astro's shiki integration —
// same theme the export dialog uses, so code looks the same everywhere.
const reactSample = `import { AsciiImage, AsciiVideo } from '@ascii-fx/react'

<AsciiImage src="/hero.jpg" alt="Portrait" columns={160} color="full"
  interaction={{ type: 'reveal', radius: 0.18 }} />

<AsciiVideo src="/clip.mp4" profile={profileRef} />`

const vanillaSample = `const ascii = await createAsciiRenderer({ canvas, profile, backend: 'auto' })

ascii.setSource(imageOrVideoOrCanvas)
ascii.start()                          // rVFC for video, rAF otherwise
ascii.setOptions({ columns: 200, color: 'mono' })
ascii.setInteraction({ type: 'push' })

const frame = await ascii.captureFrame()`

const threeSample = `const pass = new AsciiPass({ profile, renderer, columns: 160, color: 'full' })
await pass.init()

pass.render(scene, camera)             // per frame, instead of renderer.render()

// or in React Three Fiber
<AsciiEffect profile={profileRef} columns={180} interaction="reveal" />`

const configSample = `export default defineAsciiConfig({
  profiles: { default: { font: './fonts/GeistMono.woff2', charset: 'ascii' } },
  frames:   { hero: { image: './src/hero.png', columns: 140, color: 'full' } },
})

import profileRef from 'virtual:ascii-profile/default'`

const charsetSample = `// at build time
profiles: { rain: { font: './fonts/GeistMono.woff2', characters: '01 ' } }

// or narrow a built profile at runtime
const profile = subsetProfile(await loadProfile(profileRef), '01 ')`

---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{TITLE}</title>
    <meta name="description" content={DESCRIPTION} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={base + 'favicon.svg'} type="image/svg+xml" />
    <meta name="theme-color" content="#0b0b0f" />
    <meta name="author" content="Amir Abushanab" />

    {/* The card is assets/og.png, rendered by `pnpm assets` with this library and copied
        into public/ by prep.mjs — the preview is the renderer's own output. Width and
        height are declared so a crawler can lay the card out before it has fetched it. */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="ASCII FX" />
    <meta property="og:title" content={TITLE} />
    <meta property="og:description" content={DESCRIPTION} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1280" />
    <meta property="og:image:height" content="640" />
    <meta property="og:image:alt" content={OG_ALT} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={TITLE} />
    <meta name="twitter:description" content={DESCRIPTION} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={OG_ALT} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
    <style is:global set:html={fontFace}></style>
    <style is:global>
      :root {
        color-scheme: dark;
        /* The palette the benchmark chart, tables and notes below are written
           against; the controls above use the same values literally. */
        --bg: #0b0b0f;
        --panel: #12121a;
        --border: #23232f;
        --text: #d6d6de;
        --muted: #8a8a99;
        --accent: #45e845;
        --accent2: #2fa869;
        --code-bg: #14141d;
        /* Inherited, so this tints every native control at once — checkboxes and
           range sliders alike. Set per-element it is easy to miss one, which is
           how the sliders stayed browser-blue. */
        accent-color: var(--accent);
      }
      body {
        margin: 0;
        min-height: 100vh;
        background: #0b0b0f;
        color: #d6d6de;
        font: 13.5px/1.5 'Geist Mono', ui-monospace, SFMono-Regular, Menlo, monospace;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 12px;
        padding: 20px;
        box-sizing: border-box;
      }
      h1 {
        font-size: 1.3rem;
        margin: 0;
      }
      #panel {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        justify-content: center;
        width: 100%;
        max-width: 1080px;
        /* Hint tooltips stay laid out while hidden, so ones near the right
           edge used to widen the whole page. `clip` trims them horizontally
           while leaving the vertical overflow they actually need visible. */
        overflow-x: clip;
      }
      fieldset {
        border: 1px solid #23232f;
        border-radius: 10px;
        padding: 8px 12px 10px;
        margin: 0;
        display: flex;
        flex-wrap: wrap;
        gap: 8px 14px;
        align-items: center;
        background: #101018;
        /* Flex items (and fieldsets especially) default to min-content width,
           which is wider than a phone viewport. Let them shrink so their own
           controls wrap instead of pushing the page sideways. */
        min-width: 0;
        max-width: 100%;
      }
      legend {
        color: #45e845;
        padding: 0 6px;
        font-size: 0.78rem;
        letter-spacing: 0.06em;
        text-transform: uppercase;
      }
      label {
        display: flex;
        gap: 6px;
        align-items: center;
        white-space: nowrap;
      }
      .hint {
        position: relative;
        text-decoration: underline dotted #565668;
        text-underline-offset: 3px;
        cursor: help;
        outline: none;
      }
      .hint::after {
        content: attr(data-hint);
        position: absolute;
        left: 50%;
        bottom: calc(100% + 9px);
        transform: translateX(-50%) translateY(3px);
        width: max-content;
        max-width: min(270px, calc(100vw - 24px));
        white-space: normal;
        background: #1b1c24;
        color: #d6d6de;
        border: 1px solid #2c2c3a;
        border-radius: 8px;
        padding: 7px 10px;
        font-size: 12px;
        line-height: 1.45;
        text-align: left;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.55);
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.12s ease, transform 0.12s ease;
        z-index: 30;
      }
      .hint::before {
        content: '';
        position: absolute;
        left: 50%;
        bottom: calc(100% + 4px);
        transform: translateX(-50%);
        border: 5px solid transparent;
        border-top-color: #2c2c3a;
        opacity: 0;
        transition: opacity 0.12s ease;
        z-index: 30;
      }
      .hint:hover::after,
      .hint:focus-visible::after,
      .hint:hover::before,
      .hint:focus-visible::before {
        opacity: 1;
        transform: translateX(-50%) translateY(0);
      }
      .hint::before {
        transform: translateX(-50%);
      }
      svg.lucide {
        width: 14px;
        height: 14px;
        vertical-align: -2px;
        flex: 0 0 auto;
      }
      legend svg.lucide {
        vertical-align: -2.5px;
        margin-right: 2px;
      }
      select,
      input,
      button {
        max-width: 100%;
        font: inherit;
        background: #17171f;
        color: inherit;
        border: 1px solid #2c2c3a;
        border-radius: 6px;
        padding: 3px 7px;
      }
      /* One ring for every control. The browser default is blue, which passed
         unnoticed against the old periwinkle accent and does not against this
         one. :where() keeps specificity at zero so the component-level focus
         styles further down still win. */
      :where(a, button, select, summary, input, [tabindex]):focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 2px;
      }
      input[type='range'] {
        width: 90px;
        max-width: 100%;
        padding: 0;
      }
      input[type='color'] {
        width: 34px;
        height: 24px;
        padding: 1px;
      }
      input:disabled,
      select:disabled {
        opacity: 0.45;
      }
      /* Dim disabled rows via color, not opacity: the .hint tooltip inside
         sets its own colors and must stay readable on hover. */
      label:has(:disabled) {
        color: #60606c;
      }
      label[hidden],
      .warn[hidden] {
        display: none;
      }
      .warn {
        color: #facc15;
        display: inline-flex;
        align-items: center;
        gap: 5px;
      }
      button {
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 6px;
      }
      button:hover {
        border-color: #45e845;
      }
      button.flash-ok {
        border-color: var(--accent) !important;
        color: var(--accent);
        animation: pop 0.3s ease;
      }
      button.flash-err {
        border-color: #f87171 !important;
        color: #f87171;
        animation: pop 0.3s ease;
      }
      @keyframes pop {
        40% {
          transform: scale(1.07);
        }
      }
      @media (prefers-reduced-motion: reduce) {
        *,
        *::before,
        *::after {
          animation: none;
          transition: none;
        }
      }
      button.primary {
        background: #45e845;
        border-color: #45e845;
        color: #0b0b0f;
        font-weight: 600;
      }
      output {
        color: #8a8a99;
        min-width: 2.4em;
        text-align: right;
      }
      .file-input {
        position: fixed;
        left: -9999px;
        top: 0;
        width: 1px;
        height: 1px;
        opacity: 0;
      }
      /* The canvas is replaced wholesale on a matcher change, so the overlay is
         a sibling inside a stable stage rather than a child of the canvas. */
      .hero-stage {
        position: relative;
        width: min(1024px, 100%);
        display: flex;
      }
      #out {
        width: 100%;
        aspect-ratio: 16 / 9;
        border: 1px solid #1d1d28;
        border-radius: 8px;
        touch-action: none;
      }
      #stats {
        color: #8a8a99;
        min-height: 1.4em;
        text-align: center;
        max-width: 1024px;
      }
      #stats .fps-good {
        color: var(--accent);
      }
      #stats .fps-ok {
        color: #facc15;
      }
      #stats .fps-bad {
        color: #f87171;
      }
      /* Backend-fallback notes (webgpu unavailable / gpu lost): a warning, not
         routine telemetry, so it reads as one. */
      #stats .warn {
        color: #facc15;
      }
      #explainer {
        width: min(780px, 100%);
        margin: 30px auto 24px;
        color: #b9b9c6;
        line-height: 1.65;
        font-size: 13.5px;
      }
      /* Heading icon: a 4×2 block of glyphs from the real matcher, sized to sit
         on the heading's own cap height. */
      /* Heading icon: an 8×4 block of glyphs, so the heading becomes a row with
         the pictogram beside its text rather than a taller line of type. */
      #explainer h2:has(.hicon),
      #explainer h3:has(.hicon) {
        display: flex;
        align-items: center;
        gap: 0.55em;
      }
      #explainer h3 .hicon { font-size: 0.62em; }
      #explainer h3 .hicon.hicon-emoji { font-size: 1em; }
      .hicon.hicon-emoji {
        font-size: 0.85em;
        line-height: 1;
        opacity: 1;
      }
      .hicon {
        white-space: pre;
        font-size: 0.5em;
        /* A character cell is about 0.6 wide to 1 tall, so 8 columns need a
           1.2 line-height to come out square over 4 rows. */
        line-height: 1.2;
        letter-spacing: 0;
        color: #45e845;
        opacity: 0.95;
        flex: 0 0 auto;
      }
      #explainer h2 {
        color: #45e845;
        font-size: 1rem;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        margin: 2.2em 0 0.6em;
      }
      #explainer h2:first-child {
        margin-top: 0;
      }
      #explainer p {
        margin: 0.7em 0;
      }
      #explainer strong {
        color: #d6d6de;
      }
      #explainer ul,
      #explainer ol {
        margin: 0.7em 0;
        padding-left: 1.4em;
      }
      #explainer li {
        margin: 0.35em 0;
      }
      /* Typeset formulas (KaTeX). They sit in the same slab as the code blocks
         so the page reads as one thing, but scroll on their own rather than
         widening it on a narrow screen. */
      .formula {
        background: #101018;
        border: 1px solid #23232f;
        border-radius: 8px;
        padding: 12px 14px;
        margin: 0.7em 0;
        overflow-x: auto;
        overscroll-behavior-x: contain;
        color: #d6d6de;
      }
      .formula .katex {
        font-size: 1.02em;
      }
      /* KaTeX centres display math; these read as statements, not equations. */
      .formula .katex-display {
        margin: 0;
        text-align: left;
      }
      .formula .katex-display > .katex {
        text-align: left;
      }
      /* Two classes to outrank .wnote, which is defined later and sized for
         sidebar captions; under a full-width formula this should use the column. */
      .wnote.formula-note {
        max-width: none;
        margin-top: -0.35em;
      }
      #explainer h3 {
        font-size: 1rem;
        margin: 1.5rem 0 0.5rem;
        color: #d6d6de;
      }
      #explainer .lead {
        color: var(--muted);
        max-width: 46rem;
      }
      #explainer table {
        border-collapse: collapse;
        width: 100%;
        font-size: 0.85rem;
        margin: 1rem 0;
      }
      #explainer th,
      #explainer td {
        border: 1px solid var(--border);
        padding: 0.4rem 0.7rem;
        text-align: left;
      }
      #explainer td.num,
      #explainer th.num {
        text-align: right;
        font-variant-numeric: tabular-nums;
      }
      #explainer th {
        color: var(--muted);
        font-weight: 600;
      }
      /* ——— cross-library table ———
         Twelve rows of grey numbers hid the one thing the table is for: how much
         main-thread time each approach costs over the shared floor. So the cost
         column is drawn as well as printed, each row carries its family colour
         from the chart above, and how the glyph gets picked becomes a tag rather
         than a sentence. */
      #explainer table.libs th {
        white-space: nowrap;
      }
      #explainer table.libs td {
        vertical-align: middle;
      }
      #explainer table.libs .approach {
        min-width: 12rem;
      }
      #explainer table.libs .swatch {
        display: inline-block;
        width: 3px;
        height: 0.95em;
        margin-right: 0.6em;
        border-radius: 2px;
        background: var(--row);
        vertical-align: -1px;
      }
      #explainer table.libs .grid {
        color: var(--muted);
        white-space: nowrap;
      }
      /* Ours, tinted so it can be found without reading every label. */
      #explainer table.libs tr[data-us] {
        background: color-mix(in srgb, var(--accent) 8%, transparent);
      }
      /* The baseline is not a competitor — it is the line everything is measured from. */
      #explainer table.libs tr[data-floor] td {
        color: var(--muted);
      }
      #explainer .tag {
        display: inline-block;
        padding: 0.08em 0.55em;
        border: 1px solid var(--border);
        border-radius: 999px;
        color: var(--muted);
        font-size: 0.75rem;
        white-space: nowrap;
      }
      /* Green marks the rows that pick a glyph by shape — the axis that matters. */
      #explainer .tag[data-kind='exact'] {
        color: var(--accent2);
        border-color: color-mix(in srgb, var(--accent2) 55%, transparent);
        background: color-mix(in srgb, var(--accent2) 10%, transparent);
      }
      #explainer .tag[data-kind='shape'] {
        color: var(--accent2);
        border-color: color-mix(in srgb, var(--accent2) 35%, transparent);
      }
      #explainer .tag[data-kind='none'] {
        opacity: 0.55;
      }
      #explainer table.libs .cost {
        position: relative;
        min-width: 6rem;
      }
      #explainer table.libs .cost-bar {
        position: absolute;
        left: 0;
        top: 1px;
        bottom: 1px;
        background: color-mix(in srgb, var(--row) 34%, transparent);
        border-left: 2px solid color-mix(in srgb, var(--row) 85%, white);
        pointer-events: none;
      }
      #explainer table.libs .cost-num {
        position: relative;
      }
      #explainer table.libs tr[data-floor] .cost-num {
        font-size: 0.78rem;
        opacity: 0.75;
      }

      /* On a narrow screen the grid is near-constant and p95 is secondary, so
         they give way to keep the approach and its cost over the floor — the
         comparison itself — on screen without sideways scrolling. */
      @media (max-width: 640px) {
        #explainer table.libs .grid,
        #explainer table.libs th:nth-child(3),
        #explainer table.libs .p95 {
          display: none;
        }
        #explainer table.libs .approach {
          min-width: 0;
        }
        #explainer .table-scroll table.libs {
          min-width: 0;
        }
        #explainer table.libs .tag {
          white-space: normal;
        }
        #explainer table.libs .cost {
          min-width: 4.5rem;
        }
        #explainer table.libs th,
        #explainer table.libs td {
          padding: 0.35rem 0.45rem;
        }
      }

      #explainer pre.astro-code {
        background: #101018 !important;
        border: 1px solid #23232f;
        border-radius: 8px;
        padding: 12px 14px;
        overflow-x: auto;
        font-size: 12.5px;
        line-height: 1.6;
        margin: 0.8em 0;
      }

      /* Small print: footnote markers and caveats, set below body text so they
         read as an aside rather than another paragraph of the argument. */
      #explainer .fine {
        color: #6b6b7d;
        font-size: 0.78rem;
        line-height: 1.6;
        max-width: 46rem;
        margin: 0.6rem 0 0;
      }
      body > footer {
        width: min(780px, 100%);
        margin: 3rem auto 2rem;
        padding-top: 1.25rem;
        border-top: 1px solid #23232f;
        color: #6b6b7d;
        font-size: 0.8rem;
        line-height: 1.7;
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        justify-content: space-between;
        gap: 0.6rem 1.5rem;
      }
      body > footer p { margin: 0; flex: 1 1 26rem; }
      .ps-link {
        color: #8a8a99;
        text-decoration: none;
        white-space: nowrap;
        transition: color 0.15s;
      }
      .ps-link:hover { color: #d6d6de; }
      .ps-mark {
        display: inline-block;
        height: 1.32em;
        width: auto;
        margin-right: 0.05em;
        vertical-align: baseline;
        /* The mark ships cream, which is brighter than this footer's text, so
           it is dimmed to sit level with the letters it stands in for. */
        opacity: 0.72;
        transition: opacity 0.15s;
      }
      .ps-link:hover .ps-mark { opacity: 1; }

      /* Wide tables scroll in their own box rather than widening the page. */
      #explainer .table-scroll {
        overflow-x: auto;
        overscroll-behavior-x: contain;
        margin: 1rem 0;
      }
      #explainer .table-scroll table {
        margin: 0;
        min-width: 32rem;
      }
      #explainer pre {
        background: #101018;
        border: 1px solid #23232f;
        border-radius: 8px;
        padding: 10px 14px;
        overflow-x: auto;
        font-size: 12.5px;
        line-height: 1.55;
        color: #c9c9d6;
        margin: 0.8em 0;
      }
      #explainer code {
        background: #17171f;
        border-radius: 4px;
        padding: 1px 5px;
        font-size: 0.95em;
      }
      #explainer pre code {
        background: none;
        border-radius: 0;
        padding: 0;
      }
      .widget {
        background: #101018;
        border: 1px solid #23232f;
        border-radius: 8px;
        padding: 14px;
        margin: 0.9em 0;
      }
      .widget:empty::before {
        content: 'loading…';
        color: #565668;
      }
      .wrow {
        display: flex;
        flex-wrap: wrap;
        gap: 20px;
        align-items: flex-start;
      }
      .wrow > * {
        min-width: 0;
        max-width: 100%;
      }
      .wcol {
        display: flex;
        flex-direction: column;
        gap: 8px;
        align-items: flex-start;
        min-width: 0;
        max-width: 100%;
      }
      .wtitle {
        color: #45e845;
        font-size: 11px;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        white-space: nowrap;
      }
      .wnote {
        color: #8a8a99;
        font-size: 12px;
        max-width: min(230px, 100%);
      }
      .wramp {
        color: #c9c9d6;
        letter-spacing: 1px;
        font-size: 14px;
        white-space: pre;
        max-width: 100%;
        overflow-x: auto;
      }
      .pxgrid {
        display: grid;
        grid-template-columns: repeat(8, 18px);
        grid-auto-rows: 18px;
        gap: 1px;
        background: #23232f;
        border: 1px solid #23232f;
        cursor: crosshair;
        touch-action: none;
        user-select: none;
      }
      .pxgrid div {
        width: 18px;
        height: 18px;
      }
      canvas.px,
      canvas.wglyph,
      canvas.watlas {
        image-rendering: pixelated;
        display: block;
      }
      canvas.px {
        border: 1px solid #23232f;
      }
      canvas.watlas {
        border: 1px solid #23232f;
        border-radius: 4px;
        cursor: crosshair;
        touch-action: none;
      }
      .wtools {
        display: flex;
        gap: 6px;
        /* The slider row carries a fixed-width range input plus a readout that
           is wider than a phone; let it wrap rather than run off the page. */
        flex-wrap: wrap;
        align-items: center;
      }
      .wtools > * {
        min-width: 0;
      }
      .wtools button {
        font-size: 11.5px;
        padding: 2px 8px;
      }
      .wpair {
        display: flex;
        gap: 14px;
        align-items: flex-start;
      }
      .cand {
        display: flex;
        align-items: center;
        gap: 10px;
        color: #8a8a99;
        font-size: 12px;
        white-space: pre;
        padding: 1px 6px;
        border-radius: 4px;
        border: 1px solid transparent;
      }
      .cand.win {
        color: var(--accent);
        border-color: #274233;
        background: #11181299;
      }
      .wstages {
        gap: 10px;
      }
      .wstage {
        display: flex;
        flex-direction: column;
        gap: 6px;
        flex: 1 1 160px;
        min-width: 150px;
      }
      .wstagebox {
        position: relative;
        border: 1px solid #23232f;
        border-radius: 4px;
        overflow: hidden;
        /* All stages display at the source aspect: reduced samples cover
           non-square source regions, so this shows their true footprint and
           keeps the linked cell marker aligned across stages. */
        aspect-ratio: 2 / 1;
      }
      .wstagebox canvas {
        display: block;
        width: 100%;
        height: 100%;
        image-rendering: pixelated;
      }
      .wcellmark {
        position: absolute;
        border: 1.5px solid #f4f0e6;
        box-shadow: 0 0 0 1.5px #0b0b0f;
        pointer-events: none;
        border-radius: 2px;
      }
      .wdetail {
        display: flex;
        flex-wrap: wrap;
        gap: 16px;
        align-items: flex-start;
        margin-top: 12px;
      }
      /* The card sits under the stage strip and updates on hover, so its height
         must not depend on which cell you are pointing at. Two things made it
         jump: the classify sentence changes length between cell classes, which
         resized its column and repacked the whole row; and structured cells add
         a fourth column. Fixing the column width stops the repacking, and the
         reserved height below absorbs what is left. Content is top-aligned, so
         any slack sits at the bottom rather than shifting the columns. */
      .wdetail > * {
        flex: 0 0 auto;
        max-width: 100%;
      }
      .wdetail .wnote {
        width: 12rem;
        max-width: 100%;
      }
      .wdetail .wtitle {
        white-space: normal;
      }
      /* Reserved height per layout band: one row of columns when they fit, two
         when the card narrows, stacked on a phone. Each value clears the tallest
         cell class in its band, so the card never resizes while you sweep the
         stages. */
      .wdetail {
        min-height: 132px;
      }
      /* 818px is where the explainer column stops being wide enough for four
         columns on one row: 780px content − 28px widget padding = 752, against
         the 751 the row needs. */
      @media (max-width: 818px) {
        .wdetail {
          min-height: 268px;
        }
      }
      @media (max-width: 560px) {
        .wdetail {
          min-height: 472px;
        }
      }
      .wswatch {
        display: inline-block;
        width: 12px;
        height: 12px;
        border-radius: 3px;
        border: 1px solid #2c2c3a;
        vertical-align: -2px;
      }
      canvas.wtemporal {
        display: block;
        width: min(560px, 100%);
        border: 1px solid #23232f;
        border-radius: 4px;
        image-rendering: pixelated;
        margin-bottom: 10px;
      }
      /* ————— Emoji mode toggle ————— */
      .emoji-toggle {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        cursor: pointer;
        user-select: none;
        font-size: 13px;
        color: var(--muted);
        padding: 5px 13px 5px 6px;
        border: 1px solid var(--border);
        border-radius: 999px;
        background: #0e0e15;
        align-self: flex-start;
        transition: color 0.2s, border-color 0.2s;
      }
      .emoji-toggle input { position: absolute; opacity: 0; pointer-events: none; }
      .emoji-toggle .track {
        position: relative;
        width: 46px;
        height: 26px;
        border-radius: 999px;
        background: #1b1c24;
        border: 1px solid var(--border);
        flex: none;
        transition: background 0.3s ease, border-color 0.3s ease;
      }
      /* The knob is sized to hold an emoji rather than to be a dot: a 15px
         circle clipped the glyph, because an emoji's ink fills more of its em
         box than a text glyph's does. */
      .emoji-toggle .knob {
        position: absolute;
        top: 50%;
        left: 3px;
        width: 20px;
        height: 20px;
        margin-top: -10px;
        border-radius: 50%;
        background: #565668;
        display: grid;
        place-items: center;
        overflow: visible;
        transition: transform 0.34s cubic-bezier(0.34, 1.32, 0.64, 1), background 0.3s ease;
      }
      .emoji-toggle .knob::after {
        content: '';
        font-size: 15px;
        line-height: 1;
        opacity: 0;
        transform: scale(0.4) rotate(-45deg);
        transition: opacity 0.22s ease, transform 0.34s cubic-bezier(0.34, 1.5, 0.64, 1);
      }
      .emoji-toggle:hover { color: var(--text); border-color: #33344a; }
      .emoji-toggle input:focus-visible + .track { outline: 2px solid var(--accent); outline-offset: 3px; }

      .emoji-toggle input:checked ~ .emoji-label { color: var(--text); }
      .emoji-toggle input:checked + .track {
        /* border-box for BOTH origin and clip. The default is origin
           padding-box + clip border-box, which sizes the gradient to the
           padding box but paints it across the border box — and since gradients
           repeat, the 1px left over on each side shows the wrapped far end of
           the ramp, putting orange on the purple edge. */
        background: linear-gradient(90deg, #45e845, #ff4d9d 55%, #ff8a3d) border-box;
        border-color: transparent;
      }
      .emoji-toggle input:checked + .track .knob { transform: translateX(20px); background: #fff; }
      /* The knob wears an emoji once it is on, and the chip picks up the
         gradient — the control should look like what it switches to. */
      .emoji-toggle input:checked + .track .knob::after {
        content: '\1F604';
        opacity: 1;
        transform: scale(1) rotate(0deg);
      }
      body:has(#emojiMode:checked) .emoji-toggle {
        border-color: transparent;
        background:
          linear-gradient(#0e0e15, #0e0e15) padding-box,
          linear-gradient(90deg, #45e845, #ff4d9d 55%, #ff8a3d) border-box;
        border: 1px solid transparent;
      }

      /* Loading: the first flip fetches and decodes a palette, which is not
         instant, so the knob becomes the spinner rather than adding a second
         thing to look at. */
      .emoji-toggle[data-busy] { cursor: progress; }
      .emoji-toggle[data-busy] .knob {
        background: transparent;
        border: 2px solid rgba(255, 255, 255, 0.28);
        border-top-color: #fff;
        animation: emojiSpin 0.7s linear infinite;
      }
      .emoji-toggle[data-busy] .knob::after { opacity: 0; }
      @keyframes emojiSpin { to { transform: translateX(var(--knob-x, 0)) rotate(360deg); } }
      .emoji-toggle[data-busy] input:checked + .track .knob { --knob-x: 20px; }

      /* The canvas is replaced wholesale on a matcher change, so it fades
         rather than cutting between two unrelated images. */
      #out { transition: opacity 0.22s ease; }
      #out.swapping { opacity: 0.15; }

      .hero-busy {
        position: absolute;
        inset: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 12px;
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.2s ease;
      }
      .hero-stage[data-busy] .hero-busy { opacity: 1; }
      /* A soft scrim so the label stays readable over whatever the dimmed
         canvas happens to be showing underneath. */
      .hero-busy::before {
        content: '';
        position: absolute;
        width: 260px;
        height: 260px;
        border-radius: 50%;
        background: radial-gradient(closest-side, rgba(11, 11, 15, 0.94), rgba(11, 11, 15, 0));
      }
      .hero-busy-label {
        position: relative;
        color: var(--text);
        font-size: 12px;
      }
      .hero-ring {
        position: relative;
        width: 34px;
        height: 34px;
        border-radius: 50%;
        /* Same gradient as the toggle, so the wait reads as the same action. */
        background: conic-gradient(from 0deg, #45e845, #ff4d9d 35%, #ff8a3d 65%, rgba(255, 138, 61, 0) 78%);
        -webkit-mask: radial-gradient(farthest-side, transparent calc(100% - 3px), #000 calc(100% - 2.5px));
        mask: radial-gradient(farthest-side, transparent calc(100% - 3px), #000 calc(100% - 2.5px));
        animation: heroSpin 0.8s linear infinite;
      }
      @keyframes heroSpin { to { transform: rotate(360deg); } }

      @media (prefers-reduced-motion: reduce) {
        .emoji-toggle .track,
        .emoji-toggle .knob,
        .emoji-toggle .knob::after,
        .hero-busy,
        #out { transition: none; }
        .emoji-toggle[data-busy] .knob,
        .hero-ring { animation-duration: 1.6s; }
      }

      /* ————— Glyph palette (emoji mode only) ————— */
      #paletteBox { display: none; }
      body:has(#emojiMode:checked) #paletteBox { display: block; }
      .glyph-actions { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; margin-bottom: 9px; }
      .glyph-actions button { font-size: 12px; padding: 4px 9px; }
      .glyph-count { font-size: 12px; color: var(--muted); font-family: ui-monospace, Menlo, monospace; margin-left: auto; }
      .glyph-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, 34px);
        justify-content: space-between;
        gap: 4px;
        max-height: 232px;
        overflow-y: auto;
        /* The pointer paints a selection across cells, so the browser must not
           claim the gesture for scrolling or text selection first. */
        touch-action: none;
        user-select: none;
      }
      .glyph-cell {
        padding: 0;
        aspect-ratio: 1;
        display: grid;
        place-items: center;
        background: #0e0e15;
        border: 1px solid var(--border);
        border-radius: 5px;
        opacity: 0.26;
        filter: grayscale(1);
        transition: opacity 0.1s, filter 0.1s;
      }
      .glyph-cell.on { opacity: 1; filter: none; border-color: color-mix(in srgb, var(--accent) 55%, var(--border)); }
      .glyph-art { width: 28px; height: 28px; background-repeat: no-repeat; pointer-events: none; }

      /* The export panel is two full-width rows: the four formats stretch to
         share the first, the agent handoff fills the second. */
      fieldset:has(> #exportComponent) > button { flex: 1; }
      /* A full-width flex row, so the handoff sits under the export formats
         rather than reading as a fifth one. */
      .agent-row {
        flex: 1 0 100%;
        display: flex;
        margin-top: 2px;
        padding-top: 9px;
        border-top: 1px solid #1d1d28;
      }
      .agent-row .agent-copy { width: 100%; justify-content: center; }
      /* A full-width row under the dials: which of them the selected effect
         actually reads, said in words, since two of the nine ignore the
         pointer entirely and their sliders sit there looking live. */
      .fx-note {
        flex: 1 0 100%;
        margin: 0;
        font-size: 12px;
        line-height: 1.5;
        color: var(--muted);
      }
      .palette-note { font-size: 12px; color: var(--muted); line-height: 1.5; margin: 9px 0 0; max-width: 60ch; }
      /* The two comparison tables measure different objectives on different
         grids, so only the one matching the current mode is shown — side by
         side they invite a comparison that does not hold. */
      #emojiBench { display: none; }
      body:has(#emojiMode:checked) #emojiBench { display: block; }
      body:has(#emojiMode:checked) #asciiBench { display: none; }

      /* Asides marking where Emoji mode leaves the path this section describes.
         Hidden until the mode is on: with the switch off they are answering a
         question nobody asked. */
      /* Where Emoji mode leaves the path a section describes. These read as
         ordinary paragraphs rather than callouts: each one already opens by
         naming the mode, so a rule and a tint would only be saying it twice.
         They appear only when the mode is on, since with it off they answer a
         question nobody has asked. */
      .emoji-aside { display: none; }
      body:has(#emojiMode:checked) .emoji-aside { display: block; }
      /* Controls the chromatic matcher has no use for: it fits no colour, has
         no flat path, and its glyph set is a palette rather than a font. */
      body:has(#emojiMode:checked) #fontBox,
      body:has(#emojiMode:checked) #colorLab,
      body:has(#emojiMode:checked) #flatLab,
      body:has(#emojiMode:checked) #fgLab { display: none; }
    </style>
  </head>
  <body>
    {/* The one heading a search engine weighs most, so it says what this is rather than
        what part of it you are looking at — the playground is the thing under it. */}
    <h1>ASCII FX — structural ASCII rendering for the web</h1>
    <div id="heroStage" class="hero-stage">
      {/* A canvas has no accessible name of its own, and this one is the page's subject. */}
      <canvas id="out" role="img" aria-label="Live ASCII rendering of the selected source"
      ></canvas>
      <div class="hero-busy" role="status" aria-live="polite">
        <span class="hero-ring"></span>
        <span id="heroBusyLabel" class="hero-busy-label">switching…</span>
      </div>
    </div>
    <div id="stats">loading profile…</div>
    <div id="panel">
      <fieldset id="matcherBox">
        <legend><i data-lucide="toggle-right"></i> Matcher</legend>
        <label id="emojiToggle" class="emoji-toggle" title="Switch the matcher from structural-v1 (shape, fitted colour) to chromatic-v1 (baked colour emoji)">
          <input id="emojiMode" type="checkbox" />
          <span class="track"><span class="knob"></span></span>
          <span class="emoji-label">Emoji mode</span>
        </label>
      </fieldset>
      <fieldset id="paletteBox">
        <legend><i data-lucide="smile"></i> Emoji palette</legend>
        <div id="pickerHost"></div>
        <p class="palette-note">
          chromatic-v1 takes the lowest error over whatever glyphs it is given, and a flat swatch is the best possible reconstruction of a flat cell. So solid blocks win constantly. Removing a glyph is the only way to stop it being picked. 100 of 1301 start selected: the usage-curated set, within 1% of the whole pool at a thirteenth of the per-cell work.
        </p>
      </fieldset>
      <fieldset>
        <legend><i data-lucide="clapperboard"></i> Source</legend>
        <select id="source" aria-label="Source" title="What gets turned into ASCII: scenes, your webcam, or your own files (all client-side)">
          <option value="orbs" selected>Animated orbs</option>
          <option value="solids">3D solids</option>
          <option value="dvd">DVD bounce</option>
          <option value="plasma">Plasma</option>
          <option value="starfield">Starfield</option>
          <option value="life">Game of Life</option>
          <option value="clock">Clock</option>
          <option value="marquee">Marquee ♪</option>
          <option value="webcam">Webcam</option>
          <option value="upload-image">Your image…</option>
          <option value="upload-video">Your video…</option>
        </select>
        <label><input id="animate" type="checkbox" checked /> <span class="hint" tabindex="0" data-hint="Advance the scene animation every frame. Off = a still frame (interactions keep working)">animate</span></label>
        <input id="imageFile" class="file-input" type="file" accept="image/*" tabindex="-1" aria-label="Choose an image file" />
        <input id="videoFile" class="file-input" type="file" accept="video/*" tabindex="-1" aria-label="Choose a video file" />
      </fieldset>
      <fieldset>
        <legend><i data-lucide="grip"></i> Grain</legend>
        <label><span class="hint" tabindex="0" data-hint="Jitters each cell's brightness before matching, which pushes cells across glyph boundaries. Painted one block per cell — finer than that and the cell averages it away">amount</span> <input id="grain" type="range" min="0" max="0.8" step="0.02" value="0" /><output id="grainOut">0.00</output></label>
        <label><span class="hint" tabindex="0" data-hint="How often the noise is redrawn. Above ~15/s the churn stops reading as movement in the picture and starts reading as noise in the text">rate</span> <input id="grainRate" type="range" min="1" max="24" step="1" value="10" disabled /><output id="grainRateOut">10/s</output></label>
        <p class="fx-note">Not a renderer option: the noise is painted onto the source before the matcher ever sees it, so it changes which glyphs get picked rather than tinting the ones already chosen. Turning it up makes a still image live — every frame is a full re-match.</p>
      </fieldset>
      <fieldset id="fontBox">
        <legend><i data-lucide="type"></i> Font</legend>
        <select id="font" aria-label="Font" title="The glyph set. Compiled profiles render identically everywhere; system fonts are profiled at runtime in your browser">
          <option value="geist" selected>Geist Mono (compiled)</option>
          <option value="monospace">System monospace</option>
          <option value="Courier New">Courier New</option>
          <option value="Menlo">Menlo</option>
          <option value="upload">Your font file…</option>
        </select>
        <input id="fontFile" class="file-input" type="file" accept=".ttf,.otf,.woff,.woff2,font/*" tabindex="-1" aria-label="Choose a font file" />
        <label><span class="hint" tabindex="0" data-hint="Match with only these characters (e.g. 01 for binary rain). Empty = the full charset. The compiled profile can only narrow its ascii charset; runtime fonts rasterize anything the browser can draw, blocks ▀▓ and braille ⣿ included">chars</span>
          <input id="chars" type="text" placeholder="all" size="10" spellcheck="false" autocomplete="off" /></label>
      </fieldset>
      <fieldset>
        <legend><i data-lucide="cpu"></i> Backend</legend>
        <select id="backend" aria-label="Backend" title="auto uses your GPU (WebGPU) when available, and without it matches on worker threads and paints with WebGL2. Every option produces the same cells — what changes is what does the work. 'cpu (canvas2d)' is the last resort, where WebGL2 is unavailable too">
          <option value="auto" selected>auto</option>
          <option value="webgpu">webgpu</option>
          <option value="cpu">cpu + webgl2</option>
          <option value="cpu-canvas2d">cpu (canvas2d)</option>
        </select>
        <label><input id="temporal" type="checkbox" checked /> <span class="hint" tabindex="0" data-hint="Skip re-matching cells whose pixels didn't change since the last frame. Exact, great for video (WebGPU only)">temporal</span></label>
        <label><input id="adaptive" type="checkbox" checked /> <span class="hint" tabindex="0" data-hint="Automatically lower the column count when the frame rate drops, and recover when it's smooth (WebGPU only)">adaptive</span></label>
      </fieldset>
      <fieldset>
        <legend><i data-lucide="scan-text"></i> Matching</legend>
        <label><span class="hint" tabindex="0" data-hint="Characters per row. More columns = finer detail but more work per frame">columns</span> <input id="columns" type="range" min="24" max="240" step="4" value="120" /><output id="columnsOut">120</output></label>
        <label id="colorLab"><span class="hint" tabindex="0" data-hint="mono: one ink color · foreground: a fitted color per glyph · full: fitted glyph AND background color per cell (closest to the original image)">color</span>
          <select id="color">
            <option value="foreground" selected>foreground</option>
            <option value="full">full</option>
            <option value="mono">mono</option>
          </select>
        </label>
        <label><span class="hint" tabindex="0" data-hint="mask: transparent source pixels become empty cells · ignore: treat everything as opaque">alpha</span>
          <select id="alpha">
            <option value="mask" selected>mask</option>
            <option value="ignore">ignore</option>
          </select>
        </label>
        <label id="flatLab"><span class="hint" tabindex="0" data-hint="Cells with less light/dark contrast than this render as a single tone instead of a shape. Higher = smoother, lower = busier">flat</span> <input id="flat" type="range" min="0" max="48" step="1" value="15" /><output id="flatOut">15</output></label>
        <label id="fgLab" hidden><span class="hint" tabindex="0" data-hint="Ink color used for matching in mono mode. Swap fg/bg to invert (dark-on-light vs light-on-dark)">fg</span> <input id="fg" type="color" value="#ffffff" /></label>
        <label id="bgLab"><span class="hint" tabindex="0" data-hint="Backdrop color the glyph colors are fitted against (mono and foreground modes)">bg</span> <input id="bg" type="color" value="#000000" /></label>
        <label id="hystLab" hidden><span class="hint" tabindex="0" data-hint="Emoji mode only. Keep last frame's emoji unless a challenger beats it by this margin, which stops near-ties strobing on video. 0 is off">hysteresis</span> <input id="hyst" type="range" min="0" max="0.4" step="0.02" value="0" /><output id="hystOut">0.00</output></label>
