        <label><span class="hint" tabindex="0" data-hint="Softness of the effect's edge. 0 is a hard rim">feather</span> <input id="fxFeather" type="range" min="0" max="0.3" step="0.01" value="0.08" /><output id="fxFeatherOut">0.08</output></label>
        <label><span class="hint" tabindex="0" data-hint="Strength of the effect">intensity</span> <input id="fxIntensity" type="range" min="0" max="2" step="0.05" value="1" /><output id="fxIntensityOut">1.00</output></label>
