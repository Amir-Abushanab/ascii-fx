{
  "compilerOptions": {
    // TS 6 errors on deprecated options that tsup's dts step still injects
    // (baseUrl); this silences deprecations without changing behavior.
    "ignoreDeprecations": "6.0",
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023"],
    "strict": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "moduleDetection": "force",
    "noEmit": true
  }
}
